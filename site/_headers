# Cloudflare Pages headers — performance & security
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers for every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Long-lived, immutable caching for fingerprint-safe static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS change with releases — cache a week, revalidate
/styles.css
  Cache-Control: public, max-age=604800
/script.js
  Cache-Control: public, max-age=604800

# HTML should always revalidate so content updates are picked up
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
